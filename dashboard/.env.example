SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SECRET_KEY=coloque_sua_secret_key_aqui
AGENT_TOKEN=coloque_o_mesmo_token_usado_no_agent

# Usadas pela tela de login (Supabase Auth) - a anon/publishable key é
# segura de expor no navegador, não é segredo.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque_sua_publishable_key_aqui
